# Copia este archivo como .env.local y completa los valores.
# En Vercel las variables están marcadas como "Sensitive": `vercel env pull` no trae sus valores reales.

# Supabase (Project Settings → API). La URL y la anon key son públicas: viajan al navegador.
NEXT_PUBLIC_SUPABASE_URL="https://<ref-del-proyecto>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"

# Clave de servicio: SOLO servidor (src/app/actions/empleados.ts para invitar/desactivar empleados). Nunca en el cliente.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# URL pública de la app (se usa en el enlace de invitación de empleados)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Solo para Prisma (la app no lo usa en tiempo de ejecución)
DATABASE_URL="postgresql://postgres.<ref>:<clave>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<clave>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"
